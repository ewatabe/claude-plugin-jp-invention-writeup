      "size": [2.0, 1.0],
      "ref_anchor": "top_left"
    },
    {
      "id": "doctor",
      "label": "主治医端末",
      "ref": "2",
      "shape": "rectangle",
      "pos": [1.0, 4.0],
      "size": [2.0, 1.0],
      "ref_anchor": "top_left"
    },
    {
      "id": "server",
      "label": "会議運用支援サーバ",
      "ref": "100",
      "shape": "rectangle",
      "pos": [5.0, 3.0],
      "size": [3.0, 1.5],
      "ref_anchor": "top_right"
    },
    {
      "id": "internal_db",
      "label": "施設内DB",
      "ref": "3",
      "shape": "cylinder",
      "pos": [9.5, 1.5],
      "size": [2.0, 1.0],
      "ref_anchor": "top_left"
    },
    {
      "id": "external_db",
      "label": "外部DB",
