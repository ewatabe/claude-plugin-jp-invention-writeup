  "arrows": [
    {"from": "client", "to": "server", "direction": "right", "_comment": "left→right, right→left, up, down, bidirectional 等"},
    {"from": "doctor", "to": "server", "direction": "right"},
    {"from": "server", "to": "internal_db", "direction": "right"},
    {"from": "server", "to": "external_db", "direction": "right"}
  ],

  "_flowchart_example": {
    "figure_type": "flowchart",
    "steps": [
      {"id": "s1", "type": "start", "label": "開始"},
      {"id": "s2", "type": "process", "label": "〇〇を取得", "ref": "S101"},
      {"id": "s3", "type": "decision", "label": "〇〇か？", "ref": "S102"},
      {"id": "s4", "type": "process", "label": "〇〇を実行", "ref": "S103"},
      {"id": "s5", "type": "end", "label": "終了"}
    ],
    "transitions": [
      {"from": "s1", "to": "s2"},
      {"from": "s2", "to": "s3"},
      {"from": "s3", "to": "s4", "label": "Yes"},
      {"from": "s3", "to": "s5", "label": "No"},
      {"from": "s4", "to": "s5"}
    ]
  }
